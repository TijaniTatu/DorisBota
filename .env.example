# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for production.
#
# SITE_URL also needs updating in src/data/site.js, which is what the
# prerendered pages use for canonical and Open Graph URLs at build time.

# Neon Postgres. Added automatically if you install the Neon integration from
# the Vercel Marketplace; otherwise paste the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend. Create a key at resend.com/api-keys.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# The verified sending identity. The domain must be verified in Resend before
# mail will deliver; until then Resend's sandbox address works for testing.
MAIL_FROM="Doris Bota <noreply@dorisbota.com>"

# Where enquiries and diagnostic notifications are delivered.
MAIL_TO="dbota@integratedhealthsystemstransformation.com"

# Canonical origin, used to build report links in emails.
SITE_URL="https://dorisbota.com"

# Admin area at /admin. Use a long random password.
ADMIN_PASSWORD="change-me-to-something-long"

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-32-random-bytes-hex"
